{
  "name": "modforge-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.modforge.ai",
    "productName": "ModForge AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "desktop/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ModForge-AI-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ModForge-AI-Setup-${version}-${arch}.${ext}"
    },
    "asar": true,
    "portable": {
      "artifactName": "ModForge-AI-Portable-${version}-${arch}.${ext}"
    }
  }
}
